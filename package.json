{
  "name": "enterprise_commerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "seed": "node scripts/seed.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --config=jest.config.cjs tests/unit --passWithNoTests",
    "test:integration": "cross-env NODE_ENV=test jest --config=jest.config.cjs --runInBand tests/integration --testTimeout=30000",
    "test:rbac": "npx jest tests/integration/rbac.integration.test.ts --runInBand --config=jest.config.cjs",
    "test:checkout": "npx jest tests/integration/checkout.integration.test.ts --runInBand --config=jest.config.cjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.16.2",
    "@tanstack/react-query": "^5.90.10",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.70.0",
    "react-hot-toast": "^2.6.0",
    "zod": "^4.3.5",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "prisma": "^6.16.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/user-event": "^14.0.0",
    
    "dotenv": "^16.0.0",
    "cross-env": "^7.0.3"
  }
}
